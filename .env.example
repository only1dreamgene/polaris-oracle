# Never commit a real .env — see polaris-contracts/README.md for the
# corresponding on-chain pieces (feed ID placeholder, wasm hashes).

# --- required ---
ORACLE_SECRET_KEY=S...           # Stellar secret key; pays tx fees, no privileged role over user funds
ADMIN_API_KEY=                   # shared secret for admin endpoints — unset means every admin call is rejected

# --- market creation / deployment ---
# Market deployment (stellar contract deploy + invoke initialize) shells out
# to the Stellar CLI using ORACLE_SECRET_KEY directly as --source — no
# separate deployer identity/seed phrase to provision. See stellar.service.ts's
# deployMarket() doc comment for why one keypair for both roles is fine here.
LAZER_CONTRACT=                  # deployed pyth-lazer-stellar verifier (or polaris-mock-lazer on testnet)
NATIVE_XLM_SAC=                  # native XLM Stellar Asset Contract id — the collateral every market uses
TREASURY_ADDRESS=                # protocol fee / AMM-seed-liquidity recipient; defaults to the oracle's own address
# Swap fee is now a per-market curve (base_fee_bps -> min_fee_bps as volume
# grows), set at market creation via POST /markets/create, not a global
# default here — see contracts/README.md's "Cost-driven fee curve".

# --- passkey smart wallets ---
# SMART_WALLET_FACTORY_CONTRACT must already have had `initialize(admin,
# wasm_hash)` called on it once (admin-authenticated) before deployWallet
# will do anything — see contracts/README.md's "Factory wasm pinning".
# SMART_WALLET_WASM_HASH isn't passed to the factory anymore (that was the
# bug); it's kept here only as the value you pin via `initialize`.
SMART_WALLET_FACTORY_CONTRACT=   # deployed + initialize()'d polaris-smart-wallet-factory contract id
SMART_WALLET_WASM_HASH=          # sha256 of polaris_smart_wallet.wasm — what initialize() pinned this factory to (hex)

# --- capital-efficiency vault / market factory ---
# See polaris-contracts/README.md's "The capital-efficiency vault" and
# MarketFactoryService for the full design. VAULT_CONTRACT must already be
# deployed, initialize()'d (admin = this same ORACLE_SECRET_KEY), and funded
# via deposit() — the factory only ever withdraws from it and reads its
# balance, never deposits or admin-configures it.
VAULT_CONTRACT=                  # deployed + initialize()'d polaris-vault contract id
# JSON array of {feedId, hermesFeedId, symbol}. feedId is the small-integer
# Pyth Lazer id (same scheme as XLM_USD_FEED_ID, used for settlement);
# hermesFeedId is Pyth's separate 32-byte-hex Hermes registry id (same
# distinction PriceController documents), read once per factory run to pick
# a fresh strike price. Unset falls back to a single XLM/USD entry using its
# real Hermes id (verified live against hermes.pyth.network — see
# configuration.ts) — fine as-is unless you're adding more feeds.
FEED_CATALOG=
MARKET_FACTORY_INTERVAL_SECS=300        # 5min — safety-net sweep; a 'finalized' event triggers a successor immediately, this just catches what a crash could miss
MARKET_FACTORY_EXPIRY_SECS=86400        # 24h — each auto-created market's lifetime
MARKET_FACTORY_GRACE_PERIOD_SECS=3600
MARKET_FACTORY_BASE_FEE_BPS=100
MARKET_FACTORY_MIN_FEE_BPS=20
MARKET_FACTORY_INITIAL_LIQUIDITY_STROOPS=1000000000   # 100 XLM, withdrawn from the vault per market created

# Settlement cross-check: before trusting the Lazer-signed settlement price,
# compare it against Hermes' independently-fetched current price for the
# same feed (only for feeds present in FEED_CATALOG above). Defense in depth
# on top of the on-chain signature verification, not a replacement for it —
# a gap beyond this tolerance falls back to cancel() instead of settling.
SETTLE_ORACLE_TOLERANCE_BPS=150   # 1.5% — deliberately loose, see configuration.ts

# --- Pyth ---
PYTH_LAZER_TOKEN=                # without this, markets fall back to permissionless cancel() at grace expiry
XLM_USD_FEED_ID=100              # PLACEHOLDER — look up the real Lazer feed id for XLM/USD before mainnet
PYTH_LAZER_WS_URL=wss://pyth-lazer.dourolabs.app/v1/stream
PYTH_HERMES_URL=https://hermes.pyth.network

# --- network ---
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_NETWORK=testnet
MARKET_WASM_HASH=                # optional pin; recorded in polaris-contracts/README.md after each build

# --- server ---
PORT=3001
CORS_ORIGINS=http://localhost:3000
MARKETS_DB_FILE=./data/markets.db
FAUCET_MAX_PER_HOUR=3
