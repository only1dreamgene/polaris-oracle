# Never commit a real .env — see polaris-contracts/README.md for the
# corresponding on-chain pieces (feed ID placeholder, wasm hashes).

# --- required ---
ORACLE_SECRET_KEY=S...           # Stellar secret key; pays tx fees, no privileged role over user funds
ADMIN_API_KEY=                   # shared secret for admin endpoints — unset means every admin call is rejected

# --- market creation / deployment ---
# Market deployment (stellar contract deploy + invoke initialize) shells out
# to the Stellar CLI using ORACLE_SECRET_KEY directly as --source — no
# separate deployer identity/seed phrase to provision. See stellar.service.ts's
# deployMarket() doc comment for why one keypair for both roles is fine here.
LAZER_CONTRACT=                  # deployed pyth-lazer-stellar verifier (or polaris-mock-lazer on testnet)
NATIVE_XLM_SAC=                  # native XLM Stellar Asset Contract id — the collateral every market uses
TREASURY_ADDRESS=                # protocol fee / AMM-seed-liquidity recipient; defaults to the oracle's own address
PROTOCOL_FEE_BPS=100             # 1%, charged only on AMM swaps (buy/sell), never on split/merge/cancel

# --- passkey smart wallets ---
SMART_WALLET_FACTORY_CONTRACT=   # deployed polaris-smart-wallet-factory contract id
SMART_WALLET_WASM_HASH=          # sha256 of polaris_smart_wallet.wasm, as uploaded on-chain (hex)

# --- Pyth ---
PYTH_LAZER_TOKEN=                # without this, markets fall back to permissionless cancel() at grace expiry
XLM_USD_FEED_ID=100              # PLACEHOLDER — look up the real Lazer feed id for XLM/USD before mainnet
PYTH_LAZER_WS_URL=wss://pyth-lazer.dourolabs.app/v1/stream
PYTH_HERMES_URL=https://hermes.pyth.network

# --- network ---
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_NETWORK=testnet
MARKET_WASM_HASH=                # optional pin; recorded in polaris-contracts/README.md after each build

# --- server ---
PORT=3001
CORS_ORIGINS=http://localhost:3000
MARKETS_DB_FILE=./data/markets.db
FAUCET_MAX_PER_HOUR=3
